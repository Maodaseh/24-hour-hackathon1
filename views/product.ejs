<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex flex-col lg:flex-row gap-12">
    
    <!-- Left Column: Image / Feature Throttling (3-Tier) -->
    <div class="lg:w-1/2 flex flex-col gap-8">
      
      <!-- Adaptive Main Image -->
      <div class="bg-white rounded-3xl shadow-sm border border-gray-200 p-8 flex justify-center min-h-[500px] relative overflow-hidden">
        <% if (mode === 'HIGH') { %>
          <img src="<%= product.highResImage %>" alt="<%= product.title %>" class="object-contain w-full h-full relative z-10 drop-shadow-2xl">
          <span class="absolute top-4 left-4 bg-blue-600 text-white text-[10px] font-bold px-3 py-1 rounded shadow-md z-20">HIGH-RES</span>
        <% } else if (mode === 'MEDIUM') { %>
          <img src="<%= product.mediumResImage %>" alt="<%= product.title %>" class="object-contain w-full h-full relative z-10">
          <span class="absolute top-4 left-4 bg-gray-600 text-white text-[10px] font-bold px-3 py-1 rounded shadow z-20">MEDIUM-RES</span>
        <% } else { %>
          <img src="<%= product.lowResImage %>" alt="<%= product.title %>" class="object-contain w-full h-full blur-[3px] contrast-75 relative z-10 opacity-90">
          <span class="absolute top-4 left-4 bg-yellow-500 text-slate-900 text-[10px] font-bold px-3 py-1 rounded shadow z-20">DATA SAVER</span>
        <% } %>
      </div>

      <!-- Feature/JS Throttling -->
      <% if (mode === 'HIGH') { %>
        <!-- HIGH MODE: Real 3D AR Viewer (Heavy Payload) -->
        <div class="rounded-2xl shadow-2xl h-96 flex flex-col justify-center items-center relative overflow-hidden bg-slate-900 border border-slate-700 group">
          
          <!-- Heavy CSS Animation Overlay (Background) -->
          <div class="absolute inset-0 bg-[conic-gradient(at_top_right,_var(--tw-gradient-stops))] from-blue-700 via-purple-600 to-slate-900 opacity-30 animate-spin-slow pointer-events-none"></div>
          
          <!-- Google Model Viewer -->
          <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.3.0/model-viewer.min.js"></script>
          <model-viewer 
            src="<%= product.modelUrl %>"
            alt="A 3D model of <%= product.title %>"
            auto-rotate
            camera-controls
            class="w-full h-full relative z-10"
            style="width: 100%; height: 100%;"
            shadow-intensity="1"
            exposure="1.5">
          </model-viewer>
          
          <!-- Overlay HUD for AR Viewer -->
          <div class="absolute bottom-4 right-4 z-20 bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/10 pointer-events-none">
            <p class="font-mono text-[10px] text-cyan-400 font-bold flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
              WebGL ACTIVE
            </p>
          </div>
        </div>
        
        <style>
          .animate-spin-slow {
            animation: spin 8s linear infinite;
          }
          @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
          }
        </style>

      <% } else if (mode === 'MEDIUM') { %>
        <!-- MEDIUM MODE: Standard Image Gallery (No AR, No Heavy JS) -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200 flex flex-col items-center justify-center shadow-inner">
          <i class="fa-regular fa-images text-5xl text-gray-400 mb-4"></i>
          <h3 class="text-xl font-bold text-gray-700 mb-2">Standard Product Gallery</h3>
          <p class="text-gray-500 text-sm text-center mb-6">Swipe to view more angles.</p>
          <div class="flex gap-4">
            <div class="w-20 h-20 bg-white rounded-lg border-2 border-blue-500 shadow-sm cursor-pointer"></div>
            <div class="w-20 h-20 bg-white rounded-lg border border-gray-300 shadow-sm cursor-pointer hover:border-gray-400"></div>
            <div class="w-20 h-20 bg-white rounded-lg border border-gray-300 shadow-sm cursor-pointer hover:border-gray-400"></div>
          </div>
        </div>

      <% } else { %>
        <!-- LOW MODE: Static Fallback -->
        <div class="bg-amber-50 rounded-2xl p-8 border border-amber-200 flex flex-col items-center justify-center text-center shadow-sm">
          <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mb-4">
            <i class="fa-solid fa-bolt-slash text-3xl text-amber-500"></i>
          </div>
          <h3 class="text-xl font-bold text-amber-900 mb-2">Eco Mode Active</h3>
          <p class="text-amber-700 text-sm font-medium">Interactive features disabled to conserve your data and battery.</p>
        </div>
      <% } %>
    </div>

    <!-- Right Column: Details -->
    <div class="lg:w-1/2 flex flex-col gap-6">
      <div>
        <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight"><%= product.title %></h1>
        
        <div class="flex items-center gap-4 mb-6">
          <div class="flex items-center text-yellow-400 text-sm">
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star-half-stroke"></i>
          </div>
          <span class="text-gray-300">|</span>
          <span class="text-green-600 font-semibold text-sm tracking-wide uppercase">In Stock</span>
        </div>

        <!-- AI Contextual Adaptation (Ollama Summary vs Full Text) -->
        <% if (mode === 'LOW') { %>
          <div class="bg-amber-50 p-5 rounded-2xl border border-amber-200 mb-8 shadow-sm">
            <h4 class="text-amber-800 font-bold mb-3 flex items-center gap-2 text-sm uppercase tracking-wide">
              <i class="fa-solid fa-microchip animate-pulse"></i> AI Generated Summary (Data Saver)
            </h4>
            <div class="text-amber-900 text-sm whitespace-pre-line leading-relaxed"><%= product.lowModeSummary %></div>
          </div>
        <% } else { %>
          <p class="text-lg text-gray-600 leading-relaxed mb-8"><%= product.description %></p>
        <% } %>
        
        <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm mt-auto">
          <div class="text-5xl font-extrabold text-gray-900 mb-8">
            $<%= product.price.toFixed(2) %>
          </div>
          
          <div class="flex flex-col gap-4">
            <button class="w-full bg-yellow-400 hover:bg-yellow-500 text-slate-900 font-bold py-4 px-8 rounded-xl shadow-sm transition-colors text-lg flex items-center justify-center gap-3">
              <i class="fa-solid fa-cart-plus"></i> Add to Cart
            </button>
            <button class="w-full bg-orange-400 hover:bg-orange-500 text-slate-900 font-bold py-4 px-8 rounded-xl shadow-sm transition-colors text-lg">
              Buy Now
            </button>
          </div>
        </div>
        
        <!-- AI Chat Assistant (HIGH MODE ONLY) -->
        <% if (mode === 'HIGH') { %>
          <div class="mt-8 bg-slate-900 rounded-2xl border border-slate-700 p-6 shadow-2xl relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-cyan-900/20 to-purple-900/20 z-0 pointer-events-none"></div>
            
            <div class="relative z-10">
              <h4 class="text-white font-bold mb-4 flex items-center gap-2">
                <i class="fa-solid fa-robot text-cyan-400"></i> AI Shopping Assistant
              </h4>
              
              <div id="chat-log" class="bg-slate-800 rounded-xl p-4 h-48 overflow-y-auto mb-4 flex flex-col gap-3 text-sm shadow-inner">
                <div class="bg-slate-700 text-gray-200 p-3 rounded-lg rounded-tl-none self-start max-w-[85%] border border-slate-600">
                  Hi! I'm powered by a local Ollama LLM. What do you want to know about the <%= product.title %>?
                </div>
              </div>

              <form id="chat-form" class="flex gap-2">
                <input type="text" id="chat-input" placeholder="Ask a question..." class="flex-grow bg-slate-800 text-white rounded-lg px-4 py-3 border border-slate-600 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 placeholder-gray-500 shadow-inner">
                <button type="submit" class="bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold px-5 py-3 rounded-lg transition-colors flex items-center justify-center">
                  <i class="fa-solid fa-paper-plane"></i>
                </button>
              </form>
            </div>

            <script>
              document.getElementById('chat-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                const input = document.getElementById('chat-input');
                const log = document.getElementById('chat-log');
                const message = input.value.trim();
                
                if (!message) return;
                
                // Append user message
                log.innerHTML += `<div class="bg-cyan-600 text-white p-3 rounded-lg rounded-tr-none self-end max-w-[85%] shadow-md">${message}</div>`;
                input.value = '';
                
                // Scroll to bottom
                log.scrollTop = log.scrollHeight;
                
                // Show loading indicator
                const loadingId = 'loading-' + Date.now();
                log.innerHTML += `<div id="${loadingId}" class="text-cyan-400 text-xs italic self-start ml-2 mt-1 animate-pulse"><i class="fa-solid fa-circle-notch fa-spin"></i> AI is thinking...</div>`;
                log.scrollTop = log.scrollHeight;
                
                try {
                  const res = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: <%= product.id %>, message })
                  });
                  
                  document.getElementById(loadingId).remove();
                  
                  if (res.ok) {
                    const data = await res.json();
                    log.innerHTML += `<div class="bg-slate-700 text-gray-200 p-3 rounded-lg rounded-tl-none self-start max-w-[85%] border border-slate-600 shadow-md">${data.reply}</div>`;
                  } else {
                    log.innerHTML += `<div class="text-red-400 text-xs italic self-start ml-2 mt-1">Error connecting to AI backend.</div>`;
                  }
                } catch(e) {
                  document.getElementById(loadingId)?.remove();
                  log.innerHTML += `<div class="text-red-400 text-xs italic self-start ml-2 mt-1">Network error.</div>`;
                }
                
                log.scrollTop = log.scrollHeight;
              });
            </script>
          </div>
        <% } %>

      </div>
    </div>
  </div>
</main>

<%- include('partials/hud') %>
<%- include('partials/footer') %>
