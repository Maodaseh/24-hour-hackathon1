<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Aegis' %> | Adaptive Emergency Grid</title>
  <!-- LOW-END OPTIMIZATION: Conditionally block Web Fonts and Heavy Icons -->
  <% if (mode !== 'LOW') { %>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <% } %>
  
  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/style.css">

  <!-- ==================================================================== -->
  <!-- 1. EARLY CLIENT-SIDE SENSOR SCRIPT                                   -->
  <!-- Evaluates navigator.connection, deviceMemory, hardwareConcurrency    -->
  <!-- and synchronizes cookie 'client_tier' before DOM completes           -->
  <!-- ==================================================================== -->
  <script src="/js/sensor.js"></script>

  <!-- ==================================================================== -->
  <!-- 2. SMART ADAPTIVE PREFETCHING                                        -->
  <!-- HIGH-END: Prefetches related product URLs into browser cache         -->
  <!-- LOW-END: Completely omitted to preserve cellular bandwidth on 3G     -->
  <!-- ==================================================================== -->
  <!-- Prefetch logic handled in index.ejs now -->
  
  <!-- Global Dependencies -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- LOW-END OPTIMIZATION: Force default system fonts if Google Fonts is blocked -->
  <style>
    <% if (mode === 'LOW') { %>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important; }
    <% } else { %>
      body { font-family: 'Inter', sans-serif; }
    <% } %>
  </style>
</head>
<!-- LOW-END OPTIMIZATION: Grayscale Theme for OLED battery saving -->
<body class="<%= mode === 'LOW' ? 'grayscale contrast-125' : '' %>">
  <!-- Global Navigation Bar -->
  <header class="bg-slate-900 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center">
        <i class="fa-solid fa-shield-halved text-red-500 text-2xl mr-2"></i>
        <span class="font-black text-xl tracking-tight uppercase font-mono">AEGIS COMMAND</span>
      </a>

      <div class="flex items-center">
        <!-- Live Tier Indicator Pill -->
        <div class="flex items-center gap-2 bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
          <span class="w-2 h-2 rounded-full <%= mode === 'HIGH' ? 'bg-green-500' : mode === 'MEDIUM' ? 'bg-yellow-500' : 'bg-red-500' %>"></span>
          <span class="text-xs font-bold text-gray-300 uppercase tracking-wider"><%= mode %> MODE</span>
        </div>
      </div>
    </div>
  </header>
