<%- include('partials/header') %>

<!-- 3-Tier Prefetching Logic (Top of Body) -->
<% if (mode === 'HIGH') { %>
  <!-- HIGH MODE: Aggressive prefetching -->
  <% incidents.forEach(function(incident) { %>
    <link rel="prefetch" href="/incident/<%= incident.id %>">
  <% }); %>
<% } else if (mode === 'MEDIUM') { %>
  <!-- MEDIUM MODE: Limited prefetching -->
  <% incidents.slice(0, 2).forEach(function(incident) { %>
    <link rel="prefetch" href="/incident/<%= incident.id %>">
  <% }); %>
<% } else { %>
  <!-- LOW MODE: No prefetching (intentionally blank to save bandwidth) -->
<% } %>

<!-- Hero Section (Adaptive) -->
<% if (mode === 'HIGH') { %>
  <!-- HIGH MODE: Massive Cinematic Video Background -->
  <div class="relative w-full h-[50vh] flex items-center justify-center overflow-hidden mb-8 border-b-4 border-red-600">
    <video autoplay loop muted playsinline class="absolute z-0 w-auto min-w-full min-h-full max-w-none object-cover opacity-60">
      <!-- High bitrate video to consume bandwidth (simulating heavy radar/map feed) -->
      <source src="https://assets.mixkit.co/videos/preview/mixkit-particles-of-dust-swirling-in-the-air-4433-large.mp4" type="video/mp4">
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-black via-red-900/40 to-black/80 z-10"></div>
    <div class="relative z-20 text-center px-4">
      <div class="inline-block bg-red-600 text-white font-mono font-bold px-3 py-1 mb-4 rounded-sm animate-pulse flex items-center gap-2 justify-center mx-auto w-max">
        <span class="w-2 h-2 bg-white rounded-full"></span> LIVE FEED
      </div>
      <h1 class="text-5xl md:text-7xl font-black text-white tracking-tighter mb-4 drop-shadow-2xl uppercase font-mono">
        Global <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-red-600">Threat</span> Radar
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto drop-shadow-lg font-mono">Aegis Adaptive Emergency Grid. Monitoring critical incidents worldwide.</p>
    </div>
  </div>
<% } else { %>
  <!-- MEDIUM/LOW MODE: Static Lightweight Banner -->
  <div class="relative w-full py-10 bg-red-900 mb-8 flex items-center justify-center border-b-4 border-red-600">
    <div class="text-center px-4">
      <h1 class="text-3xl md:text-5xl font-black text-white tracking-tighter mb-2 uppercase font-mono flex justify-center items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation text-yellow-400"></i> Emergency Broadcast
      </h1>
      <p class="text-red-200 max-w-xl mx-auto text-sm font-mono uppercase tracking-widest">Low-Bandwidth Mode Active</p>
    </div>
  </div>
<% } %>

<!-- Main Layout -->
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 relative z-10">
  <div class="flex justify-between items-center mb-8 border-b border-gray-800 pb-4">
    <h2 class="text-3xl font-black text-white drop-shadow-md uppercase font-mono tracking-wide">Active Incidents</h2>
    <span class="text-gray-400 font-mono text-sm uppercase tracking-widest"><%= incidents.length %> Threats Monitored</span>
  </div>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <% incidents.forEach(function(incident) { %>
      
      <!-- Card Hover Logic (3-Tier) -->
      <div class="product-card-anim bg-slate-900 rounded-xl overflow-hidden border border-slate-700 flex flex-col cursor-pointer group
        <%= mode === 'HIGH' ? 'hover:-translate-y-2 hover:shadow-2xl hover:shadow-red-500/20 hover:border-red-500 transition-all duration-300 transform perspective-1000' : '' %>
        <%= mode === 'MEDIUM' ? 'hover:shadow-lg transition-shadow duration-300' : '' %>
        <%= mode === 'LOW' ? 'shadow-sm border-gray-700' : '' %>">
        
        <!-- Image Asset Swapping Logic (3-Tier) -->
        <div class="relative h-48 bg-black overflow-hidden flex items-center justify-center border-b border-slate-800">
          <% if (mode === 'HIGH') { %>
            <img src="<%= incident.highResImage %>" alt="<%= incident.title %>" class="object-cover w-full h-full <%= mode === 'HIGH' ? 'group-hover:scale-110 transition-transform duration-500 opacity-60 group-hover:opacity-100' : '' %>">
            <span class="absolute top-2 left-2 bg-red-600/80 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-1 rounded shadow-md uppercase font-mono border border-red-500">4K MAP</span>
          <% } else if (mode === 'MEDIUM') { %>
            <img src="<%= incident.mediumResImage %>" alt="<%= incident.title %>" class="object-cover w-full h-full opacity-70">
            <span class="absolute top-2 left-2 bg-slate-700 text-white text-[10px] font-bold px-2 py-1 rounded shadow uppercase font-mono">SD MAP</span>
          <% } else { %>
            <img src="<%= incident.lowResImage %>" alt="<%= incident.title %>" class="object-cover w-full h-full blur-[4px] grayscale opacity-40">
            <span class="absolute top-2 left-2 bg-yellow-600 text-black text-[10px] font-bold px-2 py-1 rounded shadow uppercase font-mono">TEXT ONLY</span>
          <% } %>
          
          <div class="absolute bottom-2 right-2 bg-black/80 backdrop-blur-md px-2 py-1 rounded border border-gray-700">
            <span class="text-[10px] font-mono font-bold <%= incident.price === 'CRITICAL' ? 'text-red-500' : (incident.price === 'SEVERE' ? 'text-orange-500' : 'text-yellow-500') %>"><%= incident.price %></span>
          </div>
        </div>
        
        <div class="p-5 flex flex-col flex-grow bg-slate-900">
          <h3 class="text-lg font-bold text-white mb-2 leading-tight font-mono uppercase">
            <a href="/incident/<%= incident.id %>" class="hover:text-red-400 transition-colors"><%= incident.title %></a>
          </h3>
          <p class="text-sm text-gray-400 line-clamp-3 mb-4 flex-grow"><%= incident.description %></p>
          
          <div class="mt-auto">
            <a href="/incident/<%= incident.id %>" class="block w-full text-center bg-slate-800 text-gray-300 font-mono font-bold py-3 px-4 rounded-lg hover:bg-red-600 hover:text-white transition-colors border border-slate-700 hover:border-red-500 uppercase text-xs tracking-widest">
              Open Briefing
            </a>
          </div>
        </div>

      </div>
    <% }); %>
  </div>
</main>

<!-- HIGH MODE: Heavy JS Effects (GSAP & Custom Cursor) -->
<% if (mode === 'HIGH') { %>
  <!-- 1. GSAP Scroll Animations -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script>
    // 2. Custom Heavy Particle Cursor (Tactical style)
    const cursorDot = document.createElement('div');
    cursorDot.className = 'pointer-events-none fixed top-0 left-0 w-8 h-8 border border-red-500 rounded-full mix-blend-screen z-[9999] transition-transform duration-75 ease-out flex items-center justify-center';
    const innerDot = document.createElement('div');
    innerDot.className = 'w-1 h-1 bg-red-500 rounded-full';
    cursorDot.appendChild(innerDot);
    document.body.appendChild(cursorDot);

    // This intentional main-thread burner runs on every single mouse movement
    window.addEventListener('mousemove', (e) => {
      cursorDot.style.transform = `translate(${e.clientX - 16}px, ${e.clientY - 16}px)`;
      
      // Intentional CPU bloat: Calculate useless math on every mouse move to spike INP
      let heavyMath = 0;
      for(let i=0; i<5000; i++) heavyMath += Math.sin(i) * Math.cos(i);
      
      // Spawn trailing crosshairs
      if (Math.random() > 0.7) {
        const particle = document.createElement('div');
        particle.className = 'pointer-events-none fixed w-1 h-1 bg-red-500 z-[9998] opacity-50';
        particle.style.left = `${e.clientX}px`;
        particle.style.top = `${e.clientY}px`;
        document.body.appendChild(particle);
        
        gsap.to(particle, {
          scale: 3,
          opacity: 0,
          duration: 0.5,
          onComplete: () => particle.remove()
        });
      }
    });
  </script>
<% } %>

<%- include('partials/hud') %>
<%- include('partials/footer') %>
